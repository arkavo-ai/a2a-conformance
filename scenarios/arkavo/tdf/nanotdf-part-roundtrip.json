{
  "id": "arkavo/tdf/nanotdf-part-roundtrip",
  "title": "Inline NanoTDF data part encrypts on send and decrypts on receipt. DRAFT STUB — activates when the arkavo adapters land; expectations follow the spec's conformance section.",
  "spec": "specs/arkavo/tdf-parts-v1.md",
  "client": {
    "op": "SendMessage",
    "params": {
      "message": {
        "messageId": "m-1",
        "role": "ROLE_USER",
        "parts": [
          {
            "text": "encrypt my payload"
          }
        ]
      }
    }
  },
  "server": {
    "respond": {
      "task": {
        "id": "t-tdf-1",
        "contextId": "c-1",
        "status": {
          "state": "TASK_STATE_COMPLETED"
        }
      }
    }
  },
  "expect": {
    "kind": "result",
    "checks": [
      {
        "path": "$.task.id",
        "equals": "t-tdf-1"
      }
    ]
  },
  "tags": [
    "arkavo",
    "tdf",
    "stub"
  ],
  "appliesTo": {
    "clients": [
      "arkavo-ext-rust",
      "arkavo-ext-swift"
    ],
    "servers": [
      "arkavo-ext-rust",
      "arkavo-ext-swift"
    ]
  }
}
