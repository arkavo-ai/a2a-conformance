{
  "id": "arkavo/tdf/tdf-part-wrong-key-fails-closed",
  "title": "KAS denial / wrong key fails closed: the A2A exchange succeeds, the encrypted part surfaces #error.code=kas-denied, no plaintext appears anywhere, and the sibling plaintext part is still delivered (tdf-parts-v1 §4, §7).",
  "spec": "specs/arkavo/tdf-parts-v1.md",
  "client": {
    "op": "GetTask",
    "params": {
      "id": "t-tdf-2"
    }
  },
  "server": {
    "respond": {
      "id": "t-tdf-2",
      "contextId": "c-1",
      "status": {
        "state": "TASK_STATE_COMPLETED"
      }
    }
  },
  "expect": {
    "kind": "result",
    "checks": [
      {
        "path": "$.id",
        "equals": "t-tdf-2"
      },
      {
        "path": "$.tdf.errorCode",
        "equals": "kas-denied"
      },
      {
        "path": "$.tdf.plaintextPresent",
        "equals": false
      },
      {
        "path": "$.tdf.sibling",
        "equals": "sibling plaintext"
      }
    ]
  },
  "tags": [
    "arkavo",
    "tdf",
    "fail-closed"
  ],
  "appliesTo": {
    "clients": [
      "arkavo-ext-rust",
      "arkavo-ext-swift"
    ],
    "servers": [
      "arkavo-ext-rust",
      "arkavo-ext-swift"
    ]
  }
}
